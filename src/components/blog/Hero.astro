---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import { Image } from "astro:assets";

import FormattedDate from "../FormattedDate.astro";
import PostViews from "./PostViews.astro";

interface Props {
	content: CollectionEntry<"post">;
}

const { content } = Astro.props;
const { data } = content;

const { remarkPluginFrontmatter } = await render(content);

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "long",
};
---

{
	data.coverImage && (
		<div class="aspect-video mb-6 overflow-hidden">
			<Image
				alt={data.coverImage.alt}
				class="h-full w-full object-cover"
				fetchpriority="high"
				format="webp"
				loading="eager"
				quality={80}
				sizes="(max-width: 768px) 100vw, 768px"
				src={data.coverImage.src}
				widths={[400, 800, 1080]}
			/>
		</div>
	)
}
{data.draft ? <span class="text-base text-red-500">(草稿)</span> : null}
<h1 class="title mb-3 sm:mb-1">
	{data.title}
</h1>
<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
	<p class="font-semibold">
		<FormattedDate date={data.publishDate} dateTimeOptions={dateTimeOptions} /> /{" "}
		{remarkPluginFrontmatter.minutesRead} 
	</p>
	<PostViews slug={content.id} />
	{
		data.updatedDate && (
			<span class="rounded-lg bg-quote/10 p-1 text-quote">
				最后更新：
				<FormattedDate class="ms-1" date={data.updatedDate} dateTimeOptions={dateTimeOptions} />
			</span>
		)
	}
</div>
{
	!!data.tags?.length && (
		<div class="mt-3">
			<svg
				aria-hidden="true"
				class="inline-block h-6 w-6"
				fill="none"
				focusable="false"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.5"
				viewBox="0 0 24 24"
				xmlns="http://www.w3.org/2000/svg"
			>
				<path d="M0 0h24v24H0z" fill="none" stroke="none" />
				<path d="M7.859 6h-2.834a2.025 2.025 0 0 0 -2.025 2.025v2.834c0 .537 .213 1.052 .593 1.432l6.116 6.116a2.025 2.025 0 0 0 2.864 0l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-6.117 -6.116a2.025 2.025 0 0 0 -1.431 -.593z" />
				<path d="M17.573 18.407l2.834 -2.834a2.025 2.025 0 0 0 0 -2.864l-7.117 -7.116" />
				<path d="M6 9h-.01" />
			</svg>
			{data.tags.map((tag, i) => (
				<span>
					<a
						aria-label={`查看标签 ${tag} 的文章`}
						class="cactus-link inline-block before:content-['#']"
						data-pagefind-filter="tag"
						href={`/tags/${encodeURIComponent(tag)}/`}
					>{tag}</a>{i < data.tags.length - 1 && ", "}
				</span>
			))}
		</div>
	)
}
